# Database
POSTGRES_DRIVER=postgresql+psycopg2
POSTGRES_USER=admin
POSTGRES_PASS=admin123
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_NAME=siat

# JWT
SECRET_KEY=please-change-me
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRES_MIN=60
REFRESH_TOKEN_EXPIRES_DAYS=7

# Cookies (access)
AUTH_COOKIE_NAME=access_token
AUTH_COOKIE_SECURE=false
AUTH_COOKIE_SAMESITE=Lax
# AUTH_COOKIE_DOMAIN=localhost
AUTH_COOKIE_PATH=/

# Cookies (refresh)
AUTH_REFRESH_COOKIE_NAME=refresh_token
AUTH_REFRESH_COOKIE_SECURE=false
AUTH_REFRESH_COOKIE_SAMESITE=Lax
# AUTH_REFRESH_COOKIE_DOMAIN=localhost
AUTH_REFRESH_COOKIE_PATH=/auth

# CSRF
CSRF_COOKIE_NAME=csrftoken
CSRF_HEADER_NAME=X-CSRF-Token

# Security
BCRYPT_ROUNDS=12
AUTH_RATE_LIMIT_PER_MIN=10
AUTH_LOGIN_FAIL_LIMIT=5
AUTH_LOGIN_LOCK_MINUTES=5

# Logging
LOG_LEVEL=INFO
# LOG_FILE=backend.log

# Email / Reset
RESET_TOKEN_EXPIRES_MIN=30
EMAIL_FROM=no-reply@example.com
# SMTP_HOST=
# SMTP_PORT=
# SMTP_USER=
# SMTP_PASS=
EMAIL_USE_TLS=true
EMAIL_STUB=true

# Tests
RUN_FRONT_TESTS=1