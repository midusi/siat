# Docker Compose Environment Variables
# Copy this file to .env and customize as needed

COMPOSE_PROJECT_NAME=siat

# Network
NETWORK_NAME=siat_network

# Security
SECRET_KEY=change-this-to-a-random-secret-key-in-production

# Database credentials (matches docker-compose.yaml)
DB_USER=admin
DB_PASS=admin123
DB_NAME=siat

# MinIO credentials & configuration
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=minioadmin
MINIO_BUCKET_NAME=siat-bucket
MINIO_PUBLIC_URL=http://localhost:9000
MINIO_URL=http://minio:9000

# Service & Frontend Configuration
BACKEND_URL=http://backend-api:8000
ORIGIN=http://localhost:3000

# Email configuration (optional)
EMAIL_FROM=no-reply@siat.com
EMAIL_STUB=true


ORS_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:9000

# Camera motion compensation (drone/shake stabilisation for zone overlays)
# Set CAMERA_MOTION_COMPENSATION=false to disable entirely.
CAMERA_MOTION_COMPENSATION=true
# Downscale factor for the optical-flow pre-compute pass (0 < scale <= 1).
CAMERA_MOTION_SCALE=0.5
# Gaussian smoothing radius (frames). Larger = smoother but slightly more lag.
CAMERA_MOTION_SMOOTH_SIGMA=1.5
# ORB re-anchor interval: match features back to the reference every N frames.
CAMERA_MOTION_ANCHOR_INTERVAL=30

# PUBLIC URLS

# The public domain of the application
ORIGIN=http://localhost:3000
# The public URL the browser should use to upload files
MINIO_PUBLIC_URL=http://minio:9000


# INTERNAL URLS
MINIO_URL=http://minio:9000
BACKEND_URL=http://backend-api:8000
MINIO_ENDPOINT_URL=http://minio:9000