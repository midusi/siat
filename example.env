# Docker Compose Environment Variables
# Copy this file to .env and customize as needed

# Security
SECRET_KEY=change-this-to-a-random-secret-key-in-production

# Database credentials (should match docker-compose.yaml)
DB_USER=admin
DB_PASS=admin123
DB_NAME=siat

# MinIO credentials (should match docker-compose.yaml)
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=minioadmin

# Email configuration (optional)
EMAIL_FROM=no-reply@siat.com
EMAIL_STUB=true


NETWORK_NAME="siat_network"

# CORS Origins (customize for your domain)
# CORS_ALLOWED_ORIGINS=http://localhost:3000,https://yourdomain.com

# PUBLIC URLS

# The public domain of the application
ORIGIN=https://localhost:3000
# The public URL the browser should use to upload files
MINIO_PUBLIC_URL=-http://localhost:9000

# INTERNAL URLS
BACKEND_URL=http://backend-api:8000

