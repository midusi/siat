# Docker Compose Environment Variables
# Copy this file to .env and customize as needed

# Security
SECRET_KEY=change-this-to-a-random-secret-key-in-production

# Database credentials (should match docker-compose.yaml)
DB_USER=admin
DB_PASS=admin123
DB_NAME=traffic_analysis

# MinIO credentials (should match docker-compose.yaml)
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=minioadmin

# Email configuration (optional)
EMAIL_FROM=no-reply@traffic-analysis.com
EMAIL_STUB=true

# CORS Origins (customize for your domain)
# CORS_ALLOWED_ORIGINS=http://localhost:3000,https://yourdomain.com
